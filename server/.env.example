# Copy this file to .env and fill in your own values. .env is not committed.
PGHOST=localhost
PGPORT=5432
PGDATABASE=idopont
PGUSER=postgres
PGPASSWORD=

# The address users open the app at; used in links sent by email (password reset)
APP_URL=http://localhost:5000
# How emails are sent. Only "console" exists for now: the email is printed in the server's output.
MAIL_TRANSPORT=console

# The admin made by "npm run create-test-admin", for local testing only
TEST_ADMIN_EMAIL=admin@example.hu
TEST_ADMIN_PASSWORD=admin1234
